# =============================================================================
# Travel Notification System — commercial deployment environment
# Copy to .env and fill in real values. NEVER commit .env.
# =============================================================================

# --- Runtime ---------------------------------------------------------------
APP_ENV=production                 # production | staging | dev | test
APP_BASE_URL=https://your-domain.example.com
FRONTEND_DIST_DIR=/app/frontend
PORT=8000
TRAVEL_NOTIFICATION_CORS_ORIGINS=https://your-domain.example.com

# --- Persistence -----------------------------------------------------------
TRAVEL_NOTIFICATION_PERSISTENCE_BACKEND=mysql   # mysql | json
TRAVEL_NOTIFICATION_DB_DIR=/data/travel-notification
TRAVEL_NOTIFICATION_MYSQL_HOST=mysql
TRAVEL_NOTIFICATION_MYSQL_PORT=3306
TRAVEL_NOTIFICATION_MYSQL_USER=travel
TRAVEL_NOTIFICATION_MYSQL_PASSWORD=change-me
TRAVEL_NOTIFICATION_MYSQL_DATABASE=travel_notification_system

# --- Authentication --------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_TOKEN_SECRET=change-me-to-a-long-random-string
VERIFICATION_CODE_SECRET=change-me-to-a-long-random-string
BOOTSTRAP_TENANT_ID=tenant-a
BOOTSTRAP_TENANT_NAME=行程管家
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-deploy
BOOTSTRAP_ADMIN_EMAIL=admin@your-domain.example.com
BOOTSTRAP_ADMIN_PHONE=

# Optional platform operator (sees all tenants, revenue, manual activation)
BOOTSTRAP_OPERATOR_USERNAME=
BOOTSTRAP_OPERATOR_PASSWORD=
BOOTSTRAP_OPERATOR_EMAIL=
BOOTSTRAP_OPERATOR_TENANT_ID=platform

# --- SMS (Aliyun Dysmsapi) -------------------------------------------------
SMS_PROVIDER=aliyun
ALIYUN_SMS_AK=
ALIYUN_SMS_SK=
ALIYUN_SMS_SIGN_NAME=江西锌鑫
ALIYUN_SMS_LOGIN_TEMPLATE_CODE=SMS_512540357
ALIYUN_SMS_REGISTER_TEMPLATE_CODE=SMS_512500353
ALIYUN_SMS_RESET_TEMPLATE_CODE=SMS_512540357
ALIYUN_SMS_NOTIFICATION_TEMPLATE_CODE=
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com

# Verification code abuse protection
VERIFICATION_CODE_TTL_SECONDS=300
VERIFICATION_CODE_COOLDOWN_SECONDS=60
VERIFICATION_CODE_DAILY_LIMIT=10
VERIFICATION_CODE_IP_DAILY_LIMIT=50
VERIFICATION_CODE_GLOBAL_DAILY_LIMIT=2000
VERIFICATION_CODE_MAX_ATTEMPTS=5
VERIFICATION_RETURN_DEBUG_CODE=false

# --- WeCom (企业微信群机器人) ---------------------------------------------
WECHAT_WEBHOOK_URL=

# --- Weather (QWeather) ----------------------------------------------------
QWEATHER_API_HOST=devapi.qweather.com
QWEATHER_API_KEY=

# --- Billing / plans -------------------------------------------------------
BILLING_CURRENCY=CNY
BILLING_TRIAL_ENABLED=true
BILLING_TRIAL_DAYS=14
BILLING_TRIAL_SMS_QUOTA=100
BILLING_ORDER_TTL_MINUTES=30
# Optional JSON override of the built-in plan catalog:
# BILLING_PLANS_JSON=[{"code":"starter","name":"标准版","price_cents":29900,...}]

# --- Payment providers -----------------------------------------------------
# Comma-separated: epay,jisufu,stripe,mock (mock is refused in production)
PAYMENT_PROVIDERS=epay,jisufu
# {provider} is replaced with epay/jisufu; provider-specific *_NOTIFY_URL wins.
PAYMENT_NOTIFY_URL=https://your-domain.example.com/api/payments/{provider}/notify
PAYMENT_RETURN_URL=https://your-domain.example.com/billing

# 易支付 (彩虹易支付 compatible)
PAYMENT_EPAY_BASE_URL=https://xnoo.cn/
PAYMENT_EPAY_PID=
PAYMENT_EPAY_KEY=
PAYMENT_EPAY_SIGN_TYPE=MD5
PAYMENT_EPAY_TYPE=alipay

# 极速付 (彩虹易支付 compatible)
PAYMENT_JISUFU_BASE_URL=https://pay.weixiue.com/
PAYMENT_JISUFU_PID=
PAYMENT_JISUFU_KEY=
PAYMENT_JISUFU_SIGN_TYPE=MD5
PAYMENT_JISUFU_TYPE=alipay

# Stripe (optional, hosted Checkout)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://your-domain.example.com/billing?paid=1
STRIPE_CANCEL_URL=https://your-domain.example.com/billing?cancelled=1

# --- Email (optional receipts / operations) -------------------------------
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=行程管家
SMTP_USE_SSL=true

# --- Notification runtime --------------------------------------------------
NOTIFICATION_QUEUE_INTERVAL_SECONDS=5
NOTIFICATION_TIMEZONE=Asia/Shanghai

# --- HTTP / operations -----------------------------------------------------
MAX_REQUEST_BODY_BYTES=26214400
# Optional bearer token protecting /api/health/detail and /api/health/metrics
METRICS_TOKEN=
# Set to false only on secondary app instances when running an external scheduler
RUN_SCHEDULER=true
TRAVEL_NOTIFICATION_DEFAULT_PASSWORD=
